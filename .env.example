# Tracker Client - Environment Configuration Template
#
# Two-file pattern:
#   .env.{mode}  — committed, environment identifier only (e.g. .env.development)
#   .env.local   — gitignored, machine secrets (copy this file to .env.local)
#
# Vite loads both automatically. .env.local always wins (highest priority).
# See: https://vite.dev/guide/env-and-mode#env-files

# -----------------------------------------------
# Machine secrets — copy to .env.local (gitignored)
# -----------------------------------------------
VITE_API_URL=http://<server-ip>:5502/api/v1
VITE_HMR_HOST=<your-dev-machine-ip>
VITE_PORT=5175
